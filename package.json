{
  "name": "friend-media-picks",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @friend-media-picks/server dev",
    "typecheck": "pnpm --filter @friend-media-picks/server typecheck",
    "lint": "oxlint --tsconfig apps/server/tsconfig.json apps/server/src",
    "lint:fix": "oxlint --fix --tsconfig apps/server/tsconfig.json apps/server/src",
    "format": "oxfmt --write apps/server/src",
    "format:check": "oxfmt --check apps/server/src",
    "db:check": "pnpm --filter @friend-media-picks/server db:check",
    "db:drop": "pnpm --filter @friend-media-picks/server db:drop",
    "db:migrate": "pnpm --filter @friend-media-picks/server db:migrate",
    "db:reset": "docker compose down --volumes && docker compose up -d",
    "db:studio": "pnpm --filter @friend-media-picks/server db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
