{
  "name": "@friend-media-picks/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "db:generate": "dotenv -e ../../.env -e .env -- drizzle-kit generate --config ./config/drizzle.config.ts",
    "db:migrate": "dotenv -e ../../.env -e .env -- drizzle-kit migrate --config ./config/drizzle.config.ts",
    "db:studio": "dotenv -e ../../.env -e .env -- drizzle-kit studio --config ./config/drizzle.config.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/sql": "^0.51.1",
    "@effect/sql-pg": "^0.52.1",
    "dotenv": "^16.6.1",
    "effect": "^3.21.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "1.0.0-beta.22",
    "vitest": "^2.1.8"
  }
}
