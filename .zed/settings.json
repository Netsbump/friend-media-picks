{
  "format_on_save": "on",
  "file_scan_exclusions": [
    "repos/**"
  ],
  "search": {
    "exclude": [
      "repos/**"
    ]
  },
  "languages": {
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": [
            "exec",
            "oxfmt",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": [
            "exec",
            "oxfmt",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    }
  }
}
